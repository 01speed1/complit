generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  Pending
  Working
  Completed
}

model User {
  id       Int       @id @default(autoincrement())
  name     String
  email    String    @unique
  googleId String    @unique
  Project  Project[]
}

model Project {
  id                    Int          @id @default(autoincrement())
  title                 String
  description           String
  start_date            DateTime
  end_date              DateTime?
  is_working            Boolean      @default(false)
  is_working_start_date DateTime?
  progress              Int          @default(0)
  status                TaskStatus   @default(Pending) // TODO: I'm not using this field, remove when you sure you don't need it
  user_id               Int
  user                  User         @relation(fields: [user_id], references: [id])
  Task                  Task[]
  Completion            Completion[]
}

model Task {
  id                    Int        @id @default(autoincrement())
  project_id            Int
  title                 String
  description           String
  progress_contribution Int
  status                TaskStatus @default(Pending)
  due_date              DateTime?
  created_at            DateTime   @default(now())
  project               Project    @relation(fields: [project_id], references: [id])
}

model Completion {
  id              Int      @id @default(autoincrement())
  project_id      Int
  completion_date DateTime
  proof_url       String
  proof_image     String
  project         Project  @relation(fields: [project_id], references: [id])
}
