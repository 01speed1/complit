{
  "name": "@complit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "node --experimental-strip-types --env-file=.env --watch src/server.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.1.0",
    "drizzle-orm": "^0.45.1",
    "fastify": "5.6.2",
    "fastify-plugin": "5.1.0",
    "postgres": "^3.4.8"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "drizzle-kit": "^0.31.8",
    "typescript": "5.9.3"
  }
}
